# Base URL aplikasi yang sedang berjalan (php artisan serve / Laragon)
SELENIUM_BASE_URL=http://localhost:8000

# true = jalankan tanpa membuka jendela browser, false = lihat browser-nya
SELENIUM_HEADLESS=true

# Akun uji (dibuat oleh: php artisan db:seed --class=SeleniumSeeder)
SELENIUM_USER_EMAIL=user@selenium.test
SELENIUM_USER_PASSWORD=password
SELENIUM_VENDOR_EMAIL=vendor@selenium.test
SELENIUM_VENDOR_PASSWORD=password
